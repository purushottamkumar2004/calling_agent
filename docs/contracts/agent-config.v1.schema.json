{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calling-agent/contracts/agent-config.v1.schema.json",
  "title": "Agent config (v1)",
  "description": "Immutable snapshot of one agent version. Returned by POST /internal/v1/calls; the Voice Worker uses it for the whole call.",
  "type": "object",
  "required": [
    "agent_id",
    "version",
    "tenant_id",
    "template",
    "languages",
    "greeting",
    "ai_disclosure",
    "system_prompt",
    "voice",
    "stt",
    "llm",
    "tools",
    "handoff",
    "safety",
    "limits",
    "timezone"
  ],
  "additionalProperties": false,
  "$defs": {
    "language": {
      "type": "string",
      "enum": [
        "en-IN",
        "hi-IN"
      ]
    },
    "localized": {
      "type": "object",
      "description": "Text per language",
      "propertyNames": {
        "enum": [
          "en-IN",
          "hi-IN"
        ]
      },
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "localizedList": {
      "type": "object",
      "description": "List of strings per language",
      "propertyNames": {
        "enum": [
          "en-IN",
          "hi-IN"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "minProperties": 1
    }
  },
  "properties": {
    "agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Name the agent introduces itself with"
    },
    "template": {
      "type": "string",
      "examples": [
        "clinic-receptionist@1"
      ]
    },
    "timezone": {
      "type": "string",
      "examples": [
        "Asia/Kolkata"
      ]
    },
    "languages": {
      "type": "object",
      "required": [
        "primary",
        "supported"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/language"
        },
        "supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/language"
          },
          "minItems": 1
        },
        "auto_switch": {
          "type": "boolean",
          "default": true,
          "description": "Follow the caller's language turn by turn (Hinglish)"
        }
      }
    },
    "greeting": {
      "$ref": "#/$defs/localized"
    },
    "ai_disclosure": {
      "type": "object",
      "required": [
        "enabled",
        "text"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "text": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "system_prompt": {
      "type": "string",
      "description": "Rendered prompt from the template plus tenant variables"
    },
    "variables": {
      "type": "object",
      "description": "Tenant values the prompt was rendered with (clinic name, address, fees...)",
      "additionalProperties": true
    },
    "voice": {
      "type": "object",
      "required": [
        "provider",
        "voice_ids"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "sarvam",
            "elevenlabs"
          ]
        },
        "voice_ids": {
          "$ref": "#/$defs/localized"
        },
        "speed": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3,
          "default": 1.0
        }
      }
    },
    "stt": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "sarvam",
            "deepgram"
          ]
        },
        "model": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Doctor names, clinic terms to boost"
        }
      }
    },
    "llm": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        },
        "max_output_tokens": {
          "type": "integer",
          "default": 250
        }
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "lookup_contact",
          "check_availability",
          "book_appointment",
          "list_appointments",
          "reschedule_appointment",
          "cancel_appointment",
          "search_knowledge",
          "transfer_to_human",
          "end_call"
        ]
      }
    },
    "knowledge_base_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "on_caller_request": {
          "type": "boolean",
          "default": true
        },
        "after_failed_turns": {
          "type": "integer",
          "default": 2
        },
        "unavailable_message": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "forbid_medical_advice",
        "emergency"
      ],
      "properties": {
        "forbid_medical_advice": {
          "type": "boolean"
        },
        "emergency": {
          "type": "object",
          "required": [
            "keywords",
            "script",
            "action"
          ],
          "properties": {
            "keywords": {
              "$ref": "#/$defs/localizedList"
            },
            "script": {
              "$ref": "#/$defs/localized"
            },
            "action": {
              "type": "string",
              "enum": [
                "transfer",
                "script_then_end"
              ]
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_duration_sec": {
          "type": "integer",
          "default": 600
        },
        "silence_timeout_sec": {
          "type": "integer",
          "default": 8
        },
        "max_reprompts": {
          "type": "integer",
          "default": 2
        },
        "tool_timeout_ms": {
          "type": "integer",
          "default": 2000
        },
        "filler_after_ms": {
          "type": "integer",
          "default": 1000
        }
      }
    },
    "recording": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "retention_days": {
          "type": "integer",
          "default": 90
        }
      }
    },
    "post_call": {
      "type": "object",
      "properties": {
        "whatsapp_confirmation": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
