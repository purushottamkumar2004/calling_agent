# Local infra only (infra/docker). Each app has its own apps/<app>/.env.example (ADR 0011).
# Never commit real values.

# Postgres. POSTGRES_USER is the schema owner used by migrations: NOT a superuser, as on RDS.
# The container superuser is separate (local admin only).
POSTGRES_SUPERUSER_PASSWORD=postgres_local
POSTGRES_USER=calling_agent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=calling_agent
POSTGRES_TEST_DB=calling_agent_test
DATABASE_URL=postgresql://calling_agent:change_me@localhost:5432/calling_agent

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Telephony (Exotel)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com

# AI providers
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
LLM_API_KEY=

# Service URLs
CORE_API_URL=http://localhost:4000
VOICE_GATEWAY_URL=http://localhost:8000

# Local dev extras (infra/docker)
NGROK_AUTHTOKEN=
VOICE_GATEWAY_PORT=8000

# Observability: OTLP endpoint (local: `pnpm infra:obs`, Grafana on http://localhost:3001)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
