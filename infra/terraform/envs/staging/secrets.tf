# App secrets for staging. Generated values live in Secrets Manager (and in the encrypted
# state); provider credentials are placeholders that operators fill in the console or CLI,
# which Terraform then leaves alone.

locals {
  # Issuers of service JWTs (ADR 0011: ES256, one key pair per service before staging).
  jwt_issuers = ["voice-gateway", "voice-worker", "scheduler", "postcall-worker"]

  # Operator-provided values per app (env var names, unprefixed inside each app, ADR 0011).
  # PROVISIONAL names: owners of each app confirm them; adding a key here adds it to the task.
  manual_secret_keys = {
    "api"             = ["SENTRY_DSN"]
    "web"             = ["SENTRY_DSN"]
    "voice-gateway"   = ["SENTRY_DSN", "EXOTEL_ACCOUNT_SID", "EXOTEL_API_KEY", "EXOTEL_API_TOKEN"]
    "voice-worker"    = ["SENTRY_DSN", "SARVAM_API_KEY", "DEEPGRAM_API_KEY", "ELEVENLABS_API_KEY", "LLM_API_KEY"]
    "scheduler"       = ["SENTRY_DSN"]
    "postcall-worker" = ["SENTRY_DSN", "LLM_API_KEY"]
  }
}

# ---- Core API generated keys (32 random bytes, base64, as apps/api config expects) ----
resource "random_bytes" "api" {
  for_each = toset(["USER_JWT_SECRET", "FIELD_ENCRYPTION_KEY", "PHONE_HASH_KEY"])
  length   = 32
}

resource "aws_secretsmanager_secret" "api_generated" {
  name                    = "${local.name}/api/generated"
  description             = "Core API keys generated by OpenTofu"
  kms_key_id              = module.data.kms_key_arn
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "api_generated" {
  secret_id = aws_secretsmanager_secret.api_generated.id
  secret_string = jsonencode(merge(
    { for k, v in random_bytes.api : k => v.base64 },
    { FIELD_ENCRYPTION_KEY_ID = "k1" },
  ))
}

# ---- Service JWT key pairs (ES256 = ECDSA P-256) ----
resource "tls_private_key" "service_jwt" {
  for_each    = toset(local.jwt_issuers)
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "aws_secretsmanager_secret" "service_jwt" {
  for_each                = toset(local.jwt_issuers)
  name                    = "${local.name}/${each.key}/service-jwt"
  description             = "ES256 private key for ${each.key} service tokens (ADR 0011)"
  kms_key_id              = module.data.kms_key_arn
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "service_jwt" {
  for_each  = toset(local.jwt_issuers)
  secret_id = aws_secretsmanager_secret.service_jwt[each.key].id
  secret_string = jsonencode({
    SERVICE_JWT_PRIVATE_KEY = tls_private_key.service_jwt[each.key].private_key_pem_pkcs8
  })
}

locals {
  # Public keys are not secret: the Core API gets them as plain config (issuer -> SPKI PEM).
  service_jwt_public_keys = jsonencode({ for iss in local.jwt_issuers : iss => tls_private_key.service_jwt[iss].public_key_pem })
}

# ---- Operator-provided secrets (placeholders) ----
resource "aws_secretsmanager_secret" "manual" {
  for_each                = local.manual_secret_keys
  name                    = "${local.name}/${each.key}/manual"
  description             = "Provider credentials and DSNs for ${each.key}; set real values outside OpenTofu"
  kms_key_id              = module.data.kms_key_arn
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "manual" {
  for_each      = local.manual_secret_keys
  secret_id     = aws_secretsmanager_secret.manual[each.key].id
  secret_string = jsonencode({ for k in each.value : k => "" }) # empty until set; apps fail fast on missing keys

  lifecycle {
    ignore_changes = [secret_string] # real values are set by operators
  }
}

locals {
  # env var -> valueFrom for an app's manual keys
  manual_env = {
    for app, keys in local.manual_secret_keys :
    app => { for k in keys : k => "${aws_secretsmanager_secret.manual[app].arn}:${k}::" }
  }
}
