# Core API (apps/api). Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Runtime connection: a LOGIN role that is a member of `api_app` (RLS enforced, not the table owner).
DATABASE_URL=postgresql://calling_agent_app:change_me_app@localhost:5432/calling_agent
# Migrations only: the schema owner role. Never given to the running service.
MIGRATION_DATABASE_URL=postgresql://calling_agent:change_me@localhost:5432/calling_agent
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=2000

REDIS_URL=redis://localhost:6379

# Dashboard user tokens (HS256). 32+ random bytes, base64.
USER_JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Service-to-service tokens for /internal/v1 (HS256, see apps/api/README.md).
SERVICE_JWT_SECRET=
SERVICE_JWT_ALLOWED_ISSUERS=voice-gateway,voice-worker,scheduler,postcall-worker
SERVICE_JWT_MAX_TTL_SEC=300

# Field-level encryption for phone numbers. Both 32 random bytes, base64.
FIELD_ENCRYPTION_KEY_ID=k1
FIELD_ENCRYPTION_KEY=
PHONE_HASH_KEY=

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_ENABLED=true
