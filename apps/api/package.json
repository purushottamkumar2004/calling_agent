{
  "name": "@calling-agent/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core API: auth, tenants, scheduling. Only writer of business data.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/scripts/migrate.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:gen": "tsx scripts/gen-contract-types.ts",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts up",
    "db:migrate:down": "tsx --env-file=.env src/scripts/migrate.ts down",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "db:setup-local-role": "tsx --env-file=.env scripts/setup-local-app-role.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/throttler": "^6",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.1",
    "node-pg-migrate": "^7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "jest": "^29",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7",
    "pino-pretty": "^13.2.0",
    "prettier": "^3",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "tsx": "^4.23.15",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  }
}
